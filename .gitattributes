# Cross-platform line ending normalization for FusionCompute API docs
# All text files: LF (Linux/Unix standard)
* text=auto eol=lf

# Windows-specific scripts: keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.zip binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary

# Docs
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Code
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
